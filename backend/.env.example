# Server Configuration
PORT=5000
NODE_ENV=development

# Allowed Frontend URL for CORS cookies (e.g. your Vercel deployment URL)
FRONTEND_URL=https://your-frontend-app.vercel.app

# Authentication & Security
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_chars
AUTH_COOKIE_NAME=study_auth_token

# Google Gemini API Key (100% Free from Google AI Studio: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# PostgreSQL Database URL (Neon.tech or Supabase Free Tier)
# e.g., postgresql://username:password@ep-cool-fog-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
# If omitted, an in-memory data store is used for local development and unit tests
DATABASE_URL=
